{
  "name": "geeked",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A personal desktop app for prompting about code, powered by your Claude Code login.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @geeked/desktop tauri dev",
    "dev:web": "pnpm --filter @geeked/desktop dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test scripts/prepare-sidecar.test.mjs scripts/release-tools.test.mjs",
    "rust:fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all",
    "rust:fmt:check": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all -- --check",
    "rust:lint": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "node scripts/check-name.mjs && pnpm qa:docs:check && pnpm design:tokens:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "sidecar": "node scripts/prepare-sidecar.mjs",
    "sidecar:placeholder": "node scripts/prepare-sidecar.mjs --placeholder",
    "qa:docs": "node --experimental-strip-types --no-warnings scripts/qa-docs.mjs",
    "qa:docs:check": "node --experimental-strip-types --no-warnings scripts/qa-docs.mjs --check",
    "storybook": "pnpm --filter @geeked/desktop storybook",
    "design:tokens": "node --experimental-strip-types --no-warnings scripts/export-tokens.mjs",
    "design:tokens:check": "node --experimental-strip-types --no-warnings scripts/export-tokens.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
